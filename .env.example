# App Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/osi-dashboard

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_this_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Session Secret (required for Microsoft SSO)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here_change_this_in_production

# Microsoft Azure AD Configuration
AZURE_CLIENT_ID=your_azure_client_id_from_azure_portal
AZURE_CLIENT_SECRET=your_azure_client_secret_from_azure_portal
AZURE_TENANT_ID=your_azure_tenant_id_from_azure_portal
AZURE_REDIRECT_URI=http://localhost:4000/api-dashboard/auth/sso/microsoft/callback

# Encryption Key (for storing Microsoft tokens - use 32 character hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# SSO Role Configuration (Optional)
# Comma-separated list of email addresses for different roles
# Admin users (full access to all features)
SSO_ADMIN_EMAILS=admin@company.com,boss@company.com
# Editor users (can manage apps but not users)
SSO_EDITOR_EMAILS=editor1@company.com,editor2@company.com
# All other SSO users will be assigned "viewer" role by default

# ============================================
# AI Chatbot Configuration (Optional)
# ============================================
# Set to 'true' to enable AI fallback when pattern matching fails
# Requires OPENAI_API_KEY to be set
ENABLE_AI_FALLBACK=false

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Only required if ENABLE_AI_FALLBACK=true
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model to use (optional, defaults to gpt-4o-mini for cost efficiency)
# Options: gpt-4o-mini (cheap), gpt-4o (powerful), gpt-3.5-turbo (legacy)
OPENAI_MODEL=gpt-4o-mini

# Model used only for structured chatbot routing when deterministic routing is unsure
CHATBOT_AI_ROUTER_MODEL=gpt-4o-mini

# Per-connector timeout for OSI app chatbot calls
CHATBOT_CONNECTOR_TIMEOUT_MS=20000

# Optional API key for trusted automation tools such as n8n document search
CHATBOT_TOOL_API_KEY=your-dashboard-chatbot-tool-api-key

# ============================================
# External App Chatbot Integration (Optional)
# ============================================
# Service-to-service API key used when routing chatbot requests to Chemical Tracker
# Chemical Tracker should validate this key on POST /chatbot/query
CHEMTRACKER_CHATBOT_API_KEY=your-chemical-tracker-chatbot-api-key

# Anthropic API Key (used for Claude tool-use routing when ENABLE_AI_FALLBACK=true and ENABLE_N8N_CHATBOT=false)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Designer and Pump Tracker service-to-service API keys
DESIGNER_CHATBOT_API_KEY=your-designer-chatbot-api-key
PUMPTRACKER_CHATBOT_API_KEY=your-pump-tracker-chatbot-api-key

# ============================================
# OneDrive / SharePoint Document Source (Optional)
# ============================================
# Uses the Azure credentials above unless these are set.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=

# Approved shared folder to index for chatbot document search.
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_ITEM_ID=
ONEDRIVE_FOLDER_WEB_URL=
